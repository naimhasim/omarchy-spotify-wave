#!/usr/bin/env bash
#
# spotify-wave-setup -- install/uninstall the Spotify Wave audio engine.
#
# Installs the config fragments from this plugin's config/ directory into the
# user's PipeWire, pipewire-pulse and WirePlumber config trees, enables the
# filter-chain host, restarts the affected services and (re)applies the saved
# state. There is a single `spotify_wave` sink: the 10-band EQ and the
# visualizer's monitor share it, so no reconciliation with another plugin is
# needed.
#
# filter-chain.service can host other filter-chains too, so its enabled state
# is tracked in setup.json (next to state.json). install records the state it
# found and only enables the unit when it is not already enabled; uninstall
# only disables it again when this plugin was the one that enabled it.
#
# Idempotent: safe to run install or uninstall repeatedly. Never restarts
# pipewire.service; pipewire-pulse.service is only restarted when its fragment
# actually changes (pulse.rules are read once at module load).

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_DIR="$(dirname "$HERE")"
HELPER="$HERE/spotify-wave"

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

PW_SRC="$PLUGIN_DIR/config/pipewire/filter-chain.conf.d/60-spotify-wave.conf"
PP_SRC="$PLUGIN_DIR/config/pipewire/pipewire-pulse.conf.d/60-spotify-wave.conf"
CC_SRC="$PLUGIN_DIR/config/pipewire/client.conf.d/60-spotify-wave.conf"
WP_SRC="$PLUGIN_DIR/config/wireplumber/wireplumber.conf.d/60-spotify-wave.conf"
PW_DST="$CONFIG_HOME/pipewire/filter-chain.conf.d/60-spotify-wave.conf"
PP_DST="$CONFIG_HOME/pipewire/pipewire-pulse.conf.d/60-spotify-wave.conf"
CC_DST="$CONFIG_HOME/pipewire/client.conf.d/60-spotify-wave.conf"
WP_DST="$CONFIG_HOME/wireplumber/wireplumber.conf.d/60-spotify-wave.conf"
STATE_DIR="$STATE_HOME/spotify-wave"
SETUP_FILE="$STATE_DIR/setup.json"
BACKUP_DIR="$STATE_DIR/backups"

# The four config fragments this plugin owns, as trusted src->dst pairs. The
# kind label disambiguates the two same-named 60-spotify-wave.conf files and
# keys the recorded hash in setup.json's installedFragments map.
FRAGMENTS=(
  "filter-chain|$PW_SRC|$PW_DST"
  "pipewire-pulse|$PP_SRC|$PP_DST"
  "client|$CC_SRC|$CC_DST"
  "wireplumber|$WP_SRC|$WP_DST"
)
FORCE=0

usage() {
  cat <<'EOF'
Usage: spotify-wave-setup <command>

Commands:
  install            Install the PipeWire client/filter-chain, pipewire-pulse
                     and WirePlumber config fragments, enable and restart
                     filter-chain.service, restart wireplumber.service, seed the
                     state file on first run and apply the saved state. Records
                     filter-chain.service's prior enabled state and only enables
                     the unit when it is not already enabled. A fragment that is
                     not the one we installed (user-edited or foreign) is backed
                     up before being replaced.
  install --force    As install, but overwrite such files without backing up.
  uninstall          Remove the installed config, restore filter-chain.service's
                     pre-install enabled state (only disable it when install
                     enabled it), restart the services and keep the state file.
                     A fragment that differs from what we installed is kept.
  uninstall --purge  Same, but also delete the state directory.
  -h, --help         Show this help.
EOF
}

die() { printf 'spotify-wave-setup: %s\n' "$*" >&2; exit 1; }

# systemctl --user is-enabled writes the state to stdout but exits non-zero for
# anything but "enabled", and prints nothing when the unit is missing. Normalise
# to the setup.json vocabulary; empty/odd output becomes "unknown".
filter_chain_state() {
  local raw
  raw=$(systemctl --user is-enabled filter-chain.service 2>/dev/null || true)
  case "$raw" in
    enabled|enabled-runtime) printf 'enabled\n' ;;
    disabled)                printf 'disabled\n' ;;
    static)                  printf 'static\n' ;;
    linked|linked-runtime)   printf 'linked\n' ;;
    masked|masked-runtime)   printf 'masked\n' ;;
    *)                       printf 'unknown\n' ;;
  esac
}

is_enabled_state() { # <state>: true when systemd reports (or would start) it
  case "$1" in enabled|linked) return 0 ;; *) return 1 ;; esac
}

# setup.json is shared state next to state.json; serialise with the helper's
# lock so concurrent runs cannot interleave (see bin/spotify-wave).
with_state_lock() { # <cmd...>
  ( flock -x 9; "$@" ) 9>"$STATE_DIR/.lock"
}

setup_before() { # earliest recorded pre-install state, empty when no record
  [ -f "$SETUP_FILE" ] || return 0
  jq -r '.filterChainEnabledBefore // empty' "$SETUP_FILE" 2>/dev/null || true
}

setup_owned() { # true only when this plugin enabled filter-chain.service
  [ -f "$SETUP_FILE" ] || { printf 'false\n'; return 0; }
  jq -r 'if .filterChainEnabledByPlugin == true then "true" else "false" end' \
    "$SETUP_FILE" 2>/dev/null || printf 'false\n'
}

_existing_fragments() { # recorded installedFragments map; {} when absent/legacy
  [ -f "$SETUP_FILE" ] || { printf '{}\n'; return 0; }
  jq -c '.installedFragments // {}' "$SETUP_FILE" 2>/dev/null || printf '{}\n'
}

_write_setup() { # <before> <owned> <fragments_json>; caller holds the lock
  local tmp
  tmp=$(mktemp "$STATE_DIR/setup.json.XXXXXX")
  jq -n --arg before "$1" --argjson owned "$2" --argjson frags "$3" \
    '{filterChainEnabledBefore: $before, filterChainEnabledByPlugin: $owned,
      installedFragments: $frags}' \
    > "$tmp"
  mv "$tmp" "$SETUP_FILE"
}

record_setup() { # <before> <owned>; preserves an existing installedFragments map
  mkdir -p "$STATE_DIR"
  with_state_lock _write_setup "$1" "$2" "$(_existing_fragments)"
}

record_fragments() { # <fragments_json>; preserves the ownership fields
  mkdir -p "$STATE_DIR"
  with_state_lock _write_setup "$(setup_before)" "$(setup_owned)" "$1"
}

fragment_record() { # <key>: recorded installed hash, empty when no record
  [ -f "$SETUP_FILE" ] || return 0
  jq -r --arg k "$1" '.installedFragments[$k] // empty' "$SETUP_FILE" 2>/dev/null || true
}

sha256_of() { sha256sum -- "$1" | cut -d' ' -f1; }

# Backups live outside the PipeWire/WirePlumber trees and never end in .conf so
# they can never be picked up as live config.
backup_path() { # <dst> <kind>
  local base kind ts p n
  base=$(basename "$1")
  kind=$2
  mkdir -p "$BACKUP_DIR"
  ts=$(date -u +%Y%m%dT%H%M%SZ)
  p="$BACKUP_DIR/$base.$kind.$ts.bak"
  n=1
  while [ -e "$p" ]; do
    p="$BACKUP_DIR/$base.$kind.$ts.$n.bak"
    n=$((n + 1))
  done
  printf '%s\n' "$p"
}

# install_fragment <kind> <src> <dst>: copy when needed, never clobber a
# user-edited/foreign file without backing it up first. Prints the new recorded
# hash; warnings go to stderr.
install_fragment() {
  local kind=$1 src=$2 dst=$3 key src_hash dst_hash rec backup
  key="$(basename "$dst"):$kind"
  src_hash=$(sha256_of "$src")
  mkdir -p "$(dirname "$dst")"

  if [ ! -e "$dst" ]; then                 # fresh install
    install -m 0644 "$src" "$dst"
    printf '%s\n' "$src_hash"
    return 0
  fi

  dst_hash=$(sha256_of "$dst")
  if [ "$dst_hash" = "$src_hash" ]; then   # already current: idempotent no-op
    printf '%s\n' "$src_hash"
    return 0
  fi

  rec=$(fragment_record "$key")
  if [ "$FORCE" -eq 0 ] && ! { [ -n "$rec" ] && [ "$dst_hash" = "$rec" ]; }; then
    backup=$(backup_path "$dst" "$kind")
    cp -p "$dst" "$backup"
    printf 'spotify-wave-setup: warning: %s differs from the installed version; backed up to %s\n' \
      "$dst" "$backup" >&2
  fi

  install -m 0644 "$src" "$dst"           # upgrade, or forced overwrite
  printf '%s\n' "$src_hash"
}

# remove_fragment <kind> <src> <dst>: delete only when the file is what we
# installed (recorded hash) or still matches the shipped source; a user-edited
# or foreign file is left in place with a warning.
remove_fragment() {
  local kind=$1 src=$2 dst=$3 key rec dst_hash
  [ -e "$dst" ] || return 0
  key="$(basename "$dst"):$kind"
  rec=$(fragment_record "$key")
  dst_hash=$(sha256_of "$dst")
  if { [ -n "$rec" ] && [ "$dst_hash" = "$rec" ]; } || cmp -s "$src" "$dst"; then
    rm -f "$dst"
  else
    printf 'spotify-wave-setup: warning: kept %s: it differs from what the plugin installed\n' \
      "$dst" >&2
  fi
}

cmd_install() {
  FORCE=0
  case "${1:-}" in
    --force) FORCE=1 ;;
    '') ;;
    *) die "install: unknown option '${1}'" ;;
  esac

  [ -f "$PW_SRC" ] || die "missing source config: $PW_SRC"
  [ -f "$PP_SRC" ] || die "missing source config: $PP_SRC"
  [ -f "$CC_SRC" ] || die "missing source config: $CC_SRC"
  [ -f "$WP_SRC" ] || die "missing source config: $WP_SRC"

  # pipewire-pulse must be restarted to pick up pulse.rules, so only do it when
  # the fragment actually changes (keeps re-running install cheap).
  local pulse_changed=0
  cmp -s "$PP_SRC" "$PP_DST" 2>/dev/null || pulse_changed=1

  # Ownership: capture filter-chain.service's enablement before changing
  # anything, and keep the earliest record on a repeated install. The unit can
  # host other filter-chains, so only enable it when needed and claim ownership
  # only when this install is what enabled it.
  local current before owned
  current=$(filter_chain_state)
  before=$(setup_before)
  [ -n "$before" ] || before=$current
  owned=$(setup_owned)

  if is_enabled_state "$before"; then
    owned=false            # already enabled before us: not ours to disable later
    is_enabled_state "$current" \
      || systemctl --user enable filter-chain.service >/dev/null 2>&1 || true
  elif ! is_enabled_state "$current"; then
    if systemctl --user enable filter-chain.service >/dev/null 2>&1; then
      owned=true
    fi
  fi
  record_setup "$before" "$owned"

  # Install the fragments, tracking them so a later install/uninstall can tell
  # "ours" from a user-edited or foreign file at the same path. Fragments that
  # are not ours are backed up (never lost) before being replaced.
  local frags_json entry kind src dst hash
  frags_json=$(_existing_fragments)
  for entry in "${FRAGMENTS[@]}"; do
    IFS='|' read -r kind src dst <<<"$entry"
    hash=$(install_fragment "$kind" "$src" "$dst")
    frags_json=$(jq -c --arg k "$(basename "$dst"):$kind" --arg h "$hash" \
      '. + {($k): $h}' <<<"$frags_json")
  done
  record_fragments "$frags_json"

  # filter-chain.service owns the spotify_wave sink; wireplumber applies the
  # stream rules. client.conf.d is read by each native client at startup, so no
  # service restart is needed for it (the running Spotify picks it up on its
  # next start).
  systemctl --user restart filter-chain.service >/dev/null 2>&1 \
    || printf 'spotify-wave-setup: warning: could not restart filter-chain.service\n' >&2
  systemctl --user restart wireplumber.service >/dev/null 2>&1 \
    || printf 'spotify-wave-setup: warning: could not restart wireplumber.service\n' >&2
  if [ "$pulse_changed" -eq 1 ]; then
    systemctl --user restart pipewire-pulse.service >/dev/null 2>&1 \
      || printf 'spotify-wave-setup: warning: could not restart pipewire-pulse.service\n' >&2
  fi

  # Seed state on first run (helper writes the default file if absent).
  "$HELPER" status >/dev/null

  # Point config/cava at the sink that is now live.
  "$HELPER" ensure-source >/dev/null 2>&1 || true

  # Push the saved state to the sink now that the node exists.
  "$HELPER" apply

  printf 'spotify-wave-setup: installed\n'
  printf '  %s\n  %s\n  %s\n  %s\n' "$PW_DST" "$PP_DST" "$CC_DST" "$WP_DST"
  printf '  filter-chain.service ready (was %s, enabled by plugin: %s)' "$before" "$owned"
  printf '; filter-chain/wireplumber restarted'
  if [ "$pulse_changed" -eq 1 ]; then
    printf '; pipewire-pulse restarted'
  fi
  printf '\n'
}

cmd_uninstall() {
  local purge=0
  case "${1:-}" in
    --purge) purge=1 ;;
    '') ;;
    *) die "uninstall: unknown option '${1}'" ;;
  esac

  local pulse_had_file=0
  if [ -f "$PP_DST" ]; then
    pulse_had_file=1
  fi

  # Only disable filter-chain.service when install was what enabled it; a unit
  # shared with other filter-chains (or a legacy install with no setup.json)
  # must be left untouched.
  local owned
  owned=$(setup_owned)

  local entry kind src dst
  for entry in "${FRAGMENTS[@]}"; do
    IFS='|' read -r kind src dst <<<"$entry"
    remove_fragment "$kind" "$src" "$dst"
  done

  if [ "$owned" = true ]; then
    systemctl --user disable filter-chain.service >/dev/null 2>&1 || true
  fi

  systemctl --user restart filter-chain.service >/dev/null 2>&1 \
    || printf 'spotify-wave-setup: warning: could not restart filter-chain.service\n' >&2
  systemctl --user restart wireplumber.service >/dev/null 2>&1 \
    || printf 'spotify-wave-setup: warning: could not restart wireplumber.service\n' >&2
  if [ "$pulse_had_file" -eq 1 ]; then
    systemctl --user restart pipewire-pulse.service >/dev/null 2>&1 \
      || printf 'spotify-wave-setup: warning: could not restart pipewire-pulse.service\n' >&2
  fi

  rm -f "$SETUP_FILE"

  if [ "$purge" -eq 1 ]; then
    rm -rf "$STATE_DIR"
    printf 'spotify-wave-setup: uninstalled (state purged)\n'
  else
    printf 'spotify-wave-setup: uninstalled (state kept at %s)\n' "$STATE_DIR"
  fi
}

main() {
  [ "$#" -gt 0 ] || { usage >&2; exit 1; }
  local cmd=$1; shift
  case "$cmd" in
    install)            cmd_install "$@" ;;
    uninstall)          cmd_uninstall "$@" ;;
    -h|--help|help)     usage ;;
    *) die "unknown command '$cmd' (try --help)" ;;
  esac
}

main "$@"
